{
	"name": "flarum-lang/dutch",
	"description": "Dutch Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/dutch",
	"license": "MIT",
	"authors": [
		{
			"name": "jaspervriends",
			"homepage": "https://github.com/jaspervriends",
			"role": "Maintainer"
		},
		{
			"name": "MichaelBelgium",
			"homepage": "https://github.com/MichaelBelgium",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/dutch/issues",
		"forum": "https://discuss.flarum.org/d/18962",
		"source": "https://github.com/flarum-lang/dutch"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Dutch",
			"category": "language",
			"icon": {
				"image": "dutch_core.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
